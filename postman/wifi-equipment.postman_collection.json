          "name": "GET — список с фильтрацией (без авторизации)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200 без токена/куки', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Список опубликованных', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('Признак is_creator (0/1)', () => {",
                  "  body.forEach(e => pm.expect(e.is_creator).to.be.oneOf([0, 1]));",
                  "});",
                  "pm.test('Гостю всегда is_creator = 0', () => {",
                  "  body.forEach(e => pm.expect(e.is_creator).to.eql(0));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
